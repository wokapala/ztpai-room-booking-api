NODE_ENV=development
PORT=3000
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roombooking
DATABASE_URL=postgres://app_user:change-me@localhost:5435/roombooking
# wygeneruj: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
# hasło kont z seeda (tylko development), min. 10 znaków
SEED_PASSWORD=replace-with-dev-password
# osobna baza dla testów integracyjnych (nazwa musi kończyć się na _test, tworzona automatycznie)
TEST_DATABASE_URL=postgres://app_user:change-me@localhost:5435/roombooking_test
